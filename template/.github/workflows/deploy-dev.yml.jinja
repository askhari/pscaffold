# Builds the API image and deploys it to the dev host with Docker Compose.
name: deploy-dev

on:
  push:
    branches: [main]
    paths:
      - apps/api/**
      - contract/**
      - infra/deploy/**
  workflow_dispatch:

concurrency:
  group: deploy-dev
  cancel-in-progress: false

permissions:
  contents: read
  packages: write

env:
  IMAGE: ghcr.io/{{ github_owner | lower }}/{{ project_slug }}-api

jobs:
  deploy:
    runs-on: ubuntu-latest
    environment: dev
    steps:
      - uses: actions/checkout@v7

      - uses: docker/setup-buildx-action@v4

      - uses: docker/login-action@v4
        with:
          registry: ghcr.io
          username: {% raw %}${{ github.actor }}{% endraw %}
          password: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}

      - uses: docker/build-push-action@v7
        with:
          context: apps/api
          push: true
          build-args: VERSION={% raw %}${{ github.sha }}{% endraw %}
          tags: |
            {% raw %}${{ env.IMAGE }}:${{ github.sha }}
            ${{ env.IMAGE }}:dev{% endraw %}
          cache-from: type=gha
          cache-to: type=gha,mode=max

      - name: Deploy over SSH
        uses: appleboy/ssh-action@v1.2.5
        env:
          API_IMAGE: {% raw %}${{ env.IMAGE }}:${{ github.sha }}{% endraw %}
        with:
          host: {% raw %}${{ secrets.DEPLOY_HOST }}{% endraw %}
          username: deploy
          key: {% raw %}${{ secrets.DEPLOY_SSH_KEY }}{% endraw %}
          envs: API_IMAGE
          script: |
            set -euo pipefail
            cd /opt/{{ project_slug }}
            echo "API_IMAGE=$API_IMAGE" > .env.image
            docker compose --env-file .env --env-file .env.image pull api
            docker compose --env-file .env --env-file .env.image up -d --remove-orphans
            docker image prune -f
