import type { ConfigContext, ExpoConfig } from 'expo/config';

{%- if mobile_builds == 'eas' %}
// Dynamic config: values that differ per environment come from EXPO_PUBLIC_* / EAS env vars.
{%- else %}
// Dynamic config: values that differ per environment come from EXPO_PUBLIC_* env vars, set
// by the `just app-*` recipes. Builds are local; EAS is not used.
{%- endif %}
export default ({ config }: ConfigContext): ExpoConfig => ({
  ...config,
  name: '{{ project_name }}',
  slug: '{{ project_slug }}',
  version: '0.1.0',
  orientation: 'default',
  icon: './assets/images/icon.png',
  scheme: '{{ project_slug | replace("-", "") }}',
  userInterfaceStyle: 'automatic',
  ios: {
    bundleIdentifier: '{{ bundle_id }}',
    supportsTablet: true,
  },
  android: {
    package: '{{ bundle_id }}',
    adaptiveIcon: {
      backgroundColor: '#E6F4FE',
      foregroundImage: './assets/images/android-icon-foreground.png',
      backgroundImage: './assets/images/android-icon-background.png',
      monochromeImage: './assets/images/android-icon-monochrome.png',
    },
  },
  web: {
    output: 'static',
    favicon: './assets/images/favicon.png',
  },
  plugins: [
    'expo-router',
    [
      'expo-splash-screen',
      {
        backgroundColor: '#208AEF',
        image: './assets/images/splash-icon.png',
        imageWidth: 76,
      },
    ],
  ],
  experiments: {
    typedRoutes: true,
    reactCompiler: true,
  },
{%- if mobile_builds == 'eas' %}
  extra: {
    // Filled by `eas init` (eas.projectId).
    ...config.extra,
  },
{%- endif %}
});
