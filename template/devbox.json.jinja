{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.18.4/.schema/devbox.schema.json",
  "packages": [
    "just@1.58.0",
    "pnpm@12.9.0",
    "postgresql_18@18.4",
    "jq@1.8.2",
    "shellcheck@0.11.0",
    "actionlint@1.7.12",
    "hadolint@2.14.0"{% if infra_target == 'digitalocean' %},
    "terraform@1.16.4",
    "tflint@0.64.0"{% endif %}
  ],
  "env": {
    "PGPORT": "{{ dev_db_port }}"
  },
  "shell": {
    "init_hook": ["just doctor --quiet || true"]
  }
}
