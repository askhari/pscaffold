# {{ project_name }} API on the shared platform (see ../README.md).
# The platform provides PostgreSQL, Caddy/TLS and the external `platform` network; this
# project only runs the API container. Deployed by .github/workflows/deploy-dev.yml into
# /opt/platform/products/{{ platform_product }}-<env>/compose.yml.
name: {{ platform_product }}-${DEPLOY_ENV:-dev}

services:
  api:
    image: ${API_IMAGE:?set by the deploy workflow}
    # The platform's Caddy proxies to this name; keep it in sync with the product's site
    # there ({{ platform_product }}-<env>.caddy).
    container_name: {{ platform_product }}-${DEPLOY_ENV:-dev}-api
    restart: unless-stopped
    env_file:
      # DATABASE_URL, written on the host by the platform when it provisions the database.
      - db.env
    environment:
      API_PORT: "8080"
    networks:
      - platform
    # The host's memory is shared by every product on the platform.
    mem_limit: 256m

networks:
  platform:
    external: true
