variable "region" {
  description = "DigitalOcean region slug."
  type        = string
  default     = "{{ do_region }}"
}

variable "size" {
  description = "Droplet size slug for dev."
  type        = string
  default     = "s-1vcpu-2gb"
}

variable "ssh_public_key" {
  description = "Public key for the deploy user (TF_VAR_ssh_public_key in CI)."
  type        = string
}
