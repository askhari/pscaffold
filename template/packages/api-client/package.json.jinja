{
  "name": "@{{ project_slug }}/api-client",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../contract/dist/openapi.yaml -o src/generated/schema.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --dir src",
    "test:contract": "vitest run --dir contract-tests"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.107.1",
    "@{{ project_slug }}/contract": "workspace:*",
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
